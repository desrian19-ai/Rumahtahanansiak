            <button onclick="closeBookingModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-xl font-bold">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <h3 class="text-xl font-extrabold text-slate-900 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-ticket text-amber-600"></i> Pendaftaran Antrean Online
            </h3>
            <p class="text-xs text-slate-500 mb-6">Silakan isi formulir untuk mendapatkan nomor tiket antrean kunjungan.</p>

            <form id="booking-form" onsubmit="submitBooking(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap Pengunjung</label>
                    <input type="text" required placeholder="Sesuai e-KTP" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">NIK (e-KTP)</label>
                        <input type="text" required maxlength="16" placeholder="16 digit NIK" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">No. WhatsApp</label>
                        <input type="tel" required placeholder="0812xxxx" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Nama WBP Yang Dikunjungi</label>
                        <input type="text" required placeholder="Nama WBP" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Hubungan Keluarga</label>
                        <select class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            <option>Orang Tua (Ayah/Ibu)</option>
                            <option>Suami / Istri</option>
                            <option>Anak Kandung</option>
                            <option>Saudara Kandung</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Rencana Tanggal Kunjungan</label>
                    <input type="date" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                </div>

                <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 rounded-xl transition-all shadow mt-2">
                    Cetak Nomor Antrean Digital
                </button>
            </form>

            <div id="booking-success" class="hidden text-center py-6 space-y-4">
                <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-3xl mx-auto">
                    <i class="fa-solid fa-check"></i>
                </div>
                <h4 class="text-lg font-bold text-slate-900">Pendaftaran Berhasil!</h4>
                <div class="bg-slate-100 p-4 rounded-xl border font-mono">
                    <span class="text-xs text-slate-500 block">NOMOR ANTREAN KUNJUNGAN</span>
                    <span class="text-3xl font-black text-amber-600" id="queue-number">A-024</span>
                </div>
                <p class="text-xs text-slate-600">Simpan bukti antrean ini dan tunjukkan kepada petugas di Loket Pendaftaran Rutan Siak pada hari H.</p>
                <button onclick="closeBookingModal()" class="bg-slate-900 text-white font-bold text-xs py-2 px-6 rounded-lg">
                    Tutup Window
                </button>
            </div>
        </div>
    </div>

    <div id="news-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 md:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeNewsModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 text-xl font-bold">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <span id="modal-news-tag" class="inline-block bg-amber-100 text-amber-800 font-bold text-xs px-2.5 py-0.5 rounded-full uppercase mb-2">Berita Harian</span>
            <h3 id="modal-news-title" class="text-xl md:text-2xl font-bold text-slate-900 mb-3">Judul Berita</h3>
            <p id="modal-news-date" class="text-xs text-slate-400 mb-4 flex items-center gap-1"><i class="fa-solid fa-calendar"></i> Tanggal Publikasi</p>

            <img id="modal-news-img" src="" class="w-full h-64 object-cover rounded-xl mb-4 border" alt="Berita Detail">

            <div id="modal-news-content" class="text-slate-700 text-sm leading-relaxed space-y-3">
                <!-- Content injected dynamically -->
            </div>
        </div>
    </div>

    <script>
        // Data Berita (Harian & Bulanan)
        const newsData = [
            {
                id: 1,
                title: "Rutan Siak Gelar Razia Kamar Hunian dan Tes Urine Bersama APH Siak",
                category: "harian",
                tag: "Berita Harian • 26 Agustus 2026",
                date: "26 Agustus 2026",
                image: "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=800&q=80",
                summary: "Petugas Rutan Kelas IIB Siak bersama jajaran Kepolisian Resor Siak menggelar penggeledahan sidak kamar hunian guna memastikan ketiadaan barang terlarang.",
                content: `
                    <p>Siak Sri Indrapura — Dalam rangka menindaklanjuti arahan Dirjen Pemasyarakatan terkait Deteksi Dini Gangguan Kamtib, Rutan Kelas IIB Siak Sri Indrapura menggelar penggeledahan insidental di blok hunian Warga Binaan Pemasyarakatan (WBP).</p>
                    <p>Kegiatan ini dilanjutkan dengan pelaksanaan tes urine secara acak bagi puluhan WBP dan petugas. Hasil pemeriksaan menunjukkan seluruh sampel dinyatakan negatif narkoba.</p>
                    <p>Kepala Rutan Siak menegaskan bahwa kegiatan ini merupakan komitmen mewujudkan Rutan Siak Bebas dari Narkoba (BERSINAR) serta menciptakan kondisi lingkungan yang kondusif.</p>
                `
            },
            {
                id: 2,
                title: "Pelatihan Keterampilan Kemandirian Pertanian dan Perikanan Bagi WBP Rutan Siak",
                category: "bulanan",
                tag: "Rangkuman Bulanan • Agustus 2026",
                date: "20 Agustus 2026",
                image: "https://images.unsplash.com/photo-1595974482597-4b8da8879bc5?auto=format&fit=crop&w=800&q=80",
                summary: "Rangkuman program pembinaan kemandirian bidang hidroponik dan budidaya ikan lele selama bulan Agustus 2026 di Rutan Siak.",
                content: `
                    <p>Siak Sri Indrapura — Sepanjang bulan Agustus 2026, Rutan Siak terus memperkuat program pembinaan kemandirian bagi Warga Binaan Pemasyarakatan (WBP) bekerjasama dengan Dinas Pertanian Kabupaten Siak.</p>
                    <p>Para warga binaan dibekali pengetahuan teknis mengenai budidaya sayuran hidroponik serta pengolahan pakan ikan lele. Hasil panen hidroponik rutin didistribusikan ke pasar lokal Siak sebagai bentuk wujud nyata kerja produktif WBP.</p>
                `
            },
            {
                id: 3,
                title: "Peringatan Hari Pengayoman Ke-81: Pembagian Sembako Bakti Sosial Rutan Siak",
                category: "pembinaan",
                tag: "Berita Harian • 18 Agustus 2026",
                date: "18 Agustus 2026",
                image: "https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=800&q=80",
                summary: "Jajaran pegawai Rutan Kelas IIB Siak menyalurkan paket bantuan sembako kepada warga kurang mampu di sekitar lingkungan kantor.",
                content: `
                    <p>Siak Sri Indrapura — Jajaran pegawai Rumah Tahanan Negara Kelas IIB Siak Sri Indrapura mengadakan kegiatan bakti sosial pembagian paket sembako dalam rangka menyambut Hari Pengayoman Ke-81.</p>
                    <p>Bantuan diserahkan langsung oleh pejabat struktural Rutan Siak kepada warga sekitar Jalan S. Syarif Hasyim yang membutuhkan, sebagai sinergi positif antara Rutan dan masyarakat setempat.</p>
                `
            }
        ];

        // Data Galeri
        const galleryData = [
            { title: "Pembinaan Kerohanian Pengajian WBP", img: "https://images.unsplash.com/photo-1542810634-71277d95dcbb?auto=format&fit=crop&w=600&q=80" },
            { title: "Pelatihan Keterampilan Pertanian Organik", img: "https://images.unsplash.com/photo-1595974482597-4b8da8879bc5?auto=format&fit=crop&w=600&q=80" },
            { title: "Pemeriksaan Kesehatan Rutin Dokter Rutan", img: "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=600&q=80" },
            { title: "Sidak Keamanan & Ketertiban Blok Hunian", img: "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=600&q=80" },
            { title: "Kegiatan Olahraga Voli WBP & Petugas", img: "https://images.unsplash.com/photo-1612872087720-bb876e2e67d1?auto=format&fit=crop&w=600&q=80" },
            { title: "Ruang Layanan Kunjungan Terpadu Rutan Siak", img: "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=600&q=80" }
        ];

        window.onload = function() {
            renderNews();
            renderGallery();
        };

        // Tab Navigation Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-link').forEach(el => {
                el.classList.remove('text-amber-600', 'bg-amber-50');
                el.classList.add('text-slate-600');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            
            const activeNav = document.getElementById(`nav-${tabId}`);
            if(activeNav) {
                activeNav.classList.add('text-amber-600', 'bg-amber-50');
                activeNav.classList.remove('text-slate-600');
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Subtab Switcher for Services Page
        function switchServiceSubTab(subTabId) {
            document.querySelectorAll('.subtab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

            document.getElementById(`subtab-${subTabId}`).classList.remove('hidden');
            document.getElementById(`subtab-btn-${subTabId}`).classList.add('active');
        }

        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Render News Grid
        function renderNews(filter = 'all', searchQuery = '') {
            const homeGrid = document.getElementById('home-news-grid');
            const allGrid = document.getElementById('all-news-grid');

            let filtered = newsData.filter(item => {
                const matchFilter = (filter === 'all') || (item.category === filter);
                const matchSearch = item.title.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                    item.summary.toLowerCase().includes(searchQuery.toLowerCase());
                return matchFilter && matchSearch;
            });

            const createCardHTML = (news) => `
                <div class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-200 flex flex-col justify-between hover:shadow-xl transition-all">
                    <div>
                        <div class="relative h-48 overflow-hidden">
                            <img src="${news.image}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" alt="${news.title}">
                            <span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-amber-400 font-bold text-[10px] px-2.5 py-1 rounded-full uppercase">
                                ${news.category}
                            </span>
                        </div>
                        <div class="p-5">
                            <span class="text-xs text-slate-400 block mb-1"><i class="fa-solid fa-calendar mr-1"></i> ${news.date}</span>
                            <h4 class="font-bold text-slate-900 text-base leading-snug mb-2 hover:text-amber-600 transition-colors cursor-pointer" onclick="openNewsModal(${news.id})">
                                ${news.title}
                            </h4>
                            <p class="text-slate-600 text-xs leading-relaxed line-clamp-3">
                                ${news.summary}
                            </p>
                        </div>
                    </div>
                    <div class="p-5 pt-0">
                        <button onclick="openNewsModal(${news.id})" class="text-amber-700 font-bold text-xs hover:underline flex items-center gap-1">
                            Baca Selengkapnya <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            `;

            if(homeGrid) {
                homeGrid.innerHTML = newsData.slice(0, 3).map(createCardHTML).join('');
            }
            if(allGrid) {
                allGrid.innerHTML = filtered.length > 0 
                    ? filtered.map(createCardHTML).join('')
                    : `<div class="col-span-3 text-center py-12 text-slate-400">Tidak ada berita yang sesuai pencarian.</div>`;
            }
        }

        // Filter & Search Functions
        function filterNews(cat) {
            document.querySelectorAll('.news-filter-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-amber-600', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-700');
            });
            event.target.classList.add('active', 'bg-amber-600', 'text-white');
            event.target.classList.remove('bg-slate-100', 'text-slate-700');
            
            renderNews(cat, document.getElementById('news-search').value);
        }

        function searchNews() {
            const query = document.getElementById('news-search').value;
            renderNews('all', query);
        }

        // Render Gallery
        function renderGallery() {
            const grid = document.getElementById('gallery-grid');
            if(!grid) return;
            grid.innerHTML = galleryData.map(item => `
                <div class="group relative rounded-2xl overflow-hidden shadow-md bg-slate-900 h-64 border border-slate-200">
                    <img src="${item.img}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 opacity-90 group-hover:opacity-100" alt="${item.title}">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent flex flex-col justify-end p-4">
                        <h4 class="text-white font-bold text-sm leading-snug">${item.title}</h4>
                        <span class="text-amber-400 text-[10px] mt-1 flex items-center gap-1"><i class="fa-solid fa-camera"></i> Dok. Kehumasan Rutan Siak</span>
                    </div>
                </div>
            `).join('');
        }

        // Modal Handlers
        function openBookingModal() {
            document.getElementById('booking-modal').classList.remove('hidden');
            document.getElementById('booking-form').reset();
            document.getElementById('booking-form').classList.remove('hidden');
            document.getElementById('booking-success').classList.add('hidden');
        }

        function closeBookingModal() {
            document.getElementById('booking-modal').classList.add('hidden');
        }

        function submitBooking(e) {
            e.preventDefault();
            const randomCode = 'A-' + Math.floor(100 + Math.random() * 900);
            document.getElementById('queue-number').innerText = randomCode;
            document.getElementById('booking-form').classList.add('hidden');
            document.getElementById('booking-success').classList.remove('hidden');
        }

        function openNewsModal(newsId) {
            const news = newsData.find(n => n.id === newsId);
            if(!news) return;

            document.getElementById('modal-news-title').innerText = news.title;
            document.getElementById('modal-news-date').innerText = news.date;
            document.getElementById('modal-news-tag').innerText = news.tag;
            document.getElementById('modal-news-img').src = news.image;
            document.getElementById('modal-news-content').innerHTML = news.content;

            document.getElementById('news-modal').classList.remove('hidden');
        }

        function closeNewsModal() {
            document.getElementById('news-modal').classList.add('hidden');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const alertBox = document.getElementById('form-alert');
            alertBox.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 5000);
        }
    </script>
</body>
</html>
